# Copy to .env.local and fill in real values. Never commit .env.local.

# Admin login
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Signs admin/buyer/supplier auth cookies (jose/JWT). Required — the app
# refuses to start without it (see lib/auth.ts).
JWT_SECRET=

# Vercel KV (Upstash Redis) — provisioned via the Vercel dashboard/CLI,
# pulled with `vercel env pull .env.local`.
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=
KV_URL=
REDIS_URL=

# Vercel Blob — stores supplier/buyer file uploads (logos, certificates,
# KYC documents). Provision a Blob store in the Vercel dashboard/CLI.
BLOB_READ_WRITE_TOKEN=

# Transactional email (Resend)
RESEND_API_KEY=
FROM_EMAIL=
NOTIFICATION_EMAIL=

# AI chat widget (Anthropic)
ANTHROPIC_API_KEY=

# Public site origin, used for metadata/canonical URLs
NEXT_PUBLIC_SITE_URL=
